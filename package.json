{
  "name": "drivekit",
  "version": "1.0.0",
  "description": "The fast, powerful, and developer-friendly Google Drive SDK & CLI for Node.js & TypeScript.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "drivekit": "bin/drivekit.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "README.ar.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "google-drive",
    "gdrive",
    "drive",
    "sdk",
    "uploader",
    "resumable-upload",
    "google-api",
    "file-manager",
    "cloud-storage"
  ],
  "author": "Moaaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Moaaz-i/drivekit.git"
  },
  "bugs": {
    "url": "https://github.com/Moaaz-i/drivekit/issues"
  },
  "homepage": "https://github.com/Moaaz-i/drivekit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/moaaz/drivekit"
  },
  "bugs": {
    "url": "https://github.com/moaaz/drivekit/issues"
  },
  "homepage": "https://github.com/moaaz/drivekit#readme",
  "dependencies": {
    "@googleapis/drive": "^27.0.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "google-auth-library": "^9.14.2",
    "mime-types": "^2.1.35",
    "ora": "^8.1.1"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.8.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.4"
  }
}
